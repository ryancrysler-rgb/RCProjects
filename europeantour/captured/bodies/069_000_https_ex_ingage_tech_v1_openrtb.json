g1Nzk5N2QtNTk0ZS00NDc5LWI5YTEtNGNjMWY4ZTNhNjgy\" alt=\"\" /></div><script>(function () {\n  // Constants\n  const adElementId = 'pb-slot-content-2-index-2';\n  const dspId = 'rubicon';\n  const bidId = '1857997d-594e-4479-b9a1-4cc1f8e3a682';\n  const impressionId = 'a73e836e-eefc-47ef-b23b-2d4626a3be03';\n  const adUnitId = '01G4JSV3T2BT8NHHJG08VNREEC';\n  const domainName = 'europeantour.com';\n  const geo = 'USA';\n  const deviceType = 'Desktop';\n  const ip = '50.248.40.186';\n  const publisherId = '01G4JSBMF2F5VGRNTJB92ZC2PP';\n  const tagId = 'pb-slot-content-2-index-2';\n  const backendApiUrl = 'https://sevents.ingage.tech/pixel';\n  const pageUrl = window.location.href;\n  const thresholdForStandardAds = 50; // 50% visibility for standard ads\n  const thresholdForLargeAds = 30; // 30% visibility for large ads\n  const viewedEventType = 'VIEWED';\n  const clickedEventType = 'CLICKED';\n\n  // Get the parent <div> element id\n  let parentDivId = '';\n  const iframe = window?.frameElement;\n  if (iframe) {\n    // Traverse up the DOM tree to find the parent <div>\n    let parentDiv = iframe?.parentElement;\n    let maxIterations = 10;\n    while (\n      parentDiv &&\n      (parentDiv?.tagName !== 'DIV' ||\n        parentDiv?.id.startsWith('google_ads_iframe_')) &&\n      maxIterations > 0\n    ) {\n      parentDiv = parentDiv?.parentElement;\n      maxIterations--;\n    }\n    // If parent div is found, use its ID\n    if (parentDiv && parentDiv?.id) {\n      parentDivId = parentDiv.id;\n    }\n    // Otherwise, look for a parent element with a valid ID\n    else {\n      let parentElement = iframe?.parentElement;\n      maxIterations = 10;\n      while (\n        parentElement &&\n        parentElement?.id.startsWith('google_ads_iframe_') &&\n        maxIterations > 0\n      ) {\n        parentElement = parentElement?.parentElement;\n        maxIterations--;\n      }\n      // If parent element is found, use its ID\n      if (parentElement && parentElement?.id