ion clearViewabilityTimer() {\n      clearTimeout(timer);\n      timer = null;\n    }\n\n    function handleVisibilityChange() {\n      if (document.visibilityState === 'hidden') {\n        clearViewabilityTimer();\n      } else {\n        startViewabilityTimer();\n      }\n    }\n\n    // Observer to check when the ad comes into view.\n    // Uses intersectionRatio instead of getVisibilityPercentage()\n    // to avoid cross-origin iframe crashes (window.parent access).\n    const observer = new IntersectionObserver(\n      (entries) => {\n        entries.forEach(entry => {\n          const visibility = entry.intersectionRatio * 100;\n          if (entry.isIntersecting && visibility >= visibilityThreshold) {\n            isCurrentlyIntersecting = true;\n            startViewabilityTimer();\n          } else {\n            isCurrentlyIntersecting = false;\n            clearViewabilityTimer();\n          }\n        });\n      },\n      {\n        threshold: visibilityThreshold / 100, // Convert percentage to decimal (e.g., 50% becomes 0.5)\n      },\n    );\n\n    document.addEventListener('visibilitychange', handleVisibilityChange);\n    observer.observe(iframe);\n  }\n\n  // Handle ad click\n  function trackAdClick() {\n    const handleClick = () => {\n      const eventData = getEventData(clickedEventType);\n      sendEventToBackend(eventData);\n    };\n\n    window.addEventListener('click', handleClick, { once: true });\n  }\n\n  function initTracking() {\n    try {\n      trackAdView();\n      trackAdClick();\n    } catch (e) {\n      console.error(e);\n    }\n  }\n\n  // Initialize tracking. Use readyState check so tracking still starts\n  // if the script is injected after DOMContentLoaded has already fired\n  // (e.g., lazy-loaded ads, dynamically inserted iframes).\n  if (document.readyState === 'loading') {\n    document.addEventListener('DOMContentLoaded', initTracking);\n  } else {\n    initTracking();\n  }\n})();\n</script>",
